#
# Minimal BusyBox config for Humax CXHD-5150C
#
CONFIG_HAVE_DOT_CONFIG=y

# Build options
CONFIG_STATIC=y
CONFIG_CROSS_COMPILER_PREFIX="mipsel-linux-uclibc-"
CONFIG_BUSYBOX_EXEC_PATH="/proc/self/exe"
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
CONFIG_SHOW_USAGE=y
CONFIG_LFS=y
CONFIG_DESKTOP=y
CONFIG_FEATURE_DEVPTS=y
CONFIG_FEATURE_PIDFILE=y
CONFIG_FEATURE_SYSLOG=y

# Init
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_COREDUMPS=y

# Shell
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_HUSH=y
CONFIG_SH_IS_ASH=y

# Core utilities
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_DATE=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_TEST=y
CONFIG_SLEEP=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_PRINTF=y
CONFIG_SEQ=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_WHICH=y
CONFIG_WHOAMI=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_PWD=y
CONFIG_ID=y
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_UNAME=y
CONFIG_UPTIME=y
CONFIG_FREE=y
CONFIG_TOP=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_DD=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y

# Login/passwd
CONFIG_LOGIN=y
CONFIG_GETTY=y
CONFIG_FEATURE_UTMP=y
CONFIG_FEATURE_WTMP=y
CONFIG_PASSWD=y
CONFIG_ADDUSER=y

# Editors
CONFIG_VI=y

# System
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_MKNOD=y
CONFIG_LOSETUP=y
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y
CONFIG_PIVOT_ROOT=y
CONFIG_SWITCH_ROOT=y
CONFIG_SYSCTL=y
CONFIG_DMESG=y
CONFIG_REBOOT=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y
CONFIG_MODPROBE=y
CONFIG_INSMOD=y
CONFIG_RMMOD=y
CONFIG_LSMOD=y
CONFIG_DEPMOD=y

# File systems
CONFIG_MKFS_EXT2=y
CONFIG_FSCK=y

# Network
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_FEATURE_IFCONFIG_HW=y
CONFIG_FEATURE_IFCONFIG_BROADCAST_PLUS=y
CONFIG_ROUTE=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_PING=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_NETSTAT=y
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_NSLOOKUP=y
CONFIG_ARP=y
CONFIG_ARPING=y
CONFIG_HOSTNAME=y
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_ARPING=y

# Telnet daemon (KEY FEATURE)
CONFIG_TELNET=y
CONFIG_FEATURE_TELNET_TTYPE=y
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_FEATURE_TELNETD_INETD_WAIT=y

# inetd
CONFIG_INETD=y

# HTTP server (for debug)
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y

# Syslog
CONFIG_SYSLOGD=y
CONFIG_KLOGD=y
CONFIG_LOGGER=y

# Misc
CONFIG_LINUXRC=y
CONFIG_FEATURE_SH_STANDALONE=y
